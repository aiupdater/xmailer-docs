{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "xMailer",
  "description": "Česká dokumentace správy kontaktů, odesílacích propojení a e-mailových kampaní pro webovou aplikaci xMailer.",
  "colors": {
    "primary": "#0055FF",
    "light": "#0099FF",
    "dark": "#0d6efd"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "windows",
    "color": {
      "light": "#F3F4F6",
      "dark": "#101010"
    }
  },
  "fonts": {
    "heading": {
      "family": "Montserrat",
      "weight": 600
    },
    "body": {
      "family": "Montserrat",
      "weight": 400
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "thumbnails": {
    "surface": "brand",
    "fonts": {
      "family": "Montserrat"
    },
    "eyebrow": {
      "source": "group",
      "style": "bar"
    },
    "preset": "minimal"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/aiupdater/febaEmail.app"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/aiupdater",
      "x": "https://x.com/0ndrej_Tuma"
    }
  },
  "search": {
    "prompt": "Hledat v dokumentaci…"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:site_name": "xMailer",
      "og:locale": "cs_CZ"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "toc"
  },
  "navigation": {
    "groups": [
      {
        "group": "Začínáme",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Práce s aplikací",
        "icon": "envelope-open-text",
        "pages": [
          "guides/contacts",
          "guides/connections",
          "guides/campaigns",
          "guides/delivery"
        ]
      },
      {
        "group": "Správa instalace",
        "icon": "server",
        "pages": [
          "admin/installation",
          "admin/operations"
        ]
      },
      {
        "group": "Nápověda",
        "icon": "life-ring",
        "pages": [
          "guides/troubleshooting"
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system",
    "latex": true
  },
  "metadata": {
    "timestamp": true
  }
}
