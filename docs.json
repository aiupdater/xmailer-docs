{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "xMailer",
  "colors": {
    "primary": "#0055FF",
    "light": "#0099FF",
    "dark": "#0d6efd"
  },
  "navigation": {
    "pages": [
      {
        "group": "Začínáme",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Práce s aplikací",
        "pages": [
          "guides/contacts",
          "guides/connections",
          "guides/campaigns",
          "guides/delivery",
          "guides/troubleshooting"
        ]
      },
      {
        "group": "Správa instalace",
        "pages": [
          "admin/installation",
          "admin/operations"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "href": "https://github.com/aiupdater/febaEmail.app",
        "label": "GitHub"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/aiupdater/febaEmail.app"
    }
  },
  "description": "Česká dokumentace správy kontaktů, odesílacích propojení a e-mailových kampaní pro webovou aplikaci xMailer.",
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "windows",
    "color": {
      "light": "#F3F4F6",
      "dark": "#101010"
    }
  },
  "search": {
    "prompt": "Hledat v dokumentaci…"
  },
  "fonts": {
    "heading": {
      "family": "Montserrat",
      "weight": 600
    },
    "body": {
      "family": "Montserrat",
      "weight": 400
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "thumbnails": {
    "surface": "brand",
    "fonts": {
      "family": "Montserrat"
    },
    "eyebrow": {
      "source": "dropdown",
      "style": "bar"
    }
  }
}
